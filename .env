# =================================================================
# Guardra Server Configuration
# =================================================================

# Port on which the host exposes the Guardra API (Matching Cloudflare Tunnel 8756)
SERVER_PORT=8756

# Allowed CORS Origins (Use * for all, or specify domains e.g. https://yourdomain.com,chrome-extension://*)
ALLOWED_ORIGINS=*

# Environment mode (production / development)
ENVIRONMENT=production

# Admin Console Secret Key
ADMIN_SECRET_KEY=guardra_admin_secret_2026
